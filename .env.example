# ─────────────────────────────────────────────────────────────
# SUPABASE (database, innlogging, fillagring) – PÅKREVD
# ─────────────────────────────────────────────────────────────
# Prosjekt: northwestcoast, region eu-central-1 (Frankfurt).
#
# Dette er de eneste to variablene appen må ha. Begge er offentlige: den
# publiserbare nøkkelen sendes uansett med til nettleseren, og det er RLS og
# funksjonene i databasen som beskytter dataene.
#
# Appen bruker IKKE service-role-nøkkelen. SUPABASE_SERVICE_ROLE_KEY skal
# ikke settes, og bør fjernes fra Vercel hvis den ligger der.
#
# VIKTIG: gratisnivået pauser prosjektet etter ~7 dagers inaktivitet.
# I produksjon må prosjektet stå på Pro, ellers stopper innlogging og
# bestilling av seg selv.
#
# Lokal utvikling uten å røre produksjon: se supabase/local/README.md
# (start.sh skriver ut verdiene som skal inn i .env.local).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# E-POST – valgfritt, men nødvendig for kvitteringer og varsler på e-post
# ─────────────────────────────────────────────────────────────
# Uten RESEND_API_KEY virker alt (bestillinger, rapporter og varsler ligger i
# databasen og vises i portalen), men ingen får e-post. Lokalt skrives
# e-postene til konsollen i stedet. Avsenderdomenet i RESEND_FROM_EMAIL må
# være verifisert i Resend.
#
# Innloggingslenkene sendes av Supabase, ikke herfra: sett opp egen SMTP i
# Supabase (se DEPLOYMENT.md). Den innebygde e-posten der leverer bare til
# medlemmer av Supabase-organisasjonen.
#
# Leverandør bak lib/mail. Bytte til Brevo: legg til lib/mail/brevo.ts,
# ta den inn i switchen i lib/mail/index.ts, og sett MAIL_PROVIDER=brevo.
MAIL_PROVIDER=resend

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@northwestcoast.no

# Mottakere. ORDER_/MAINTENANCE_ faller tilbake på CONTACT_TO_EMAIL.
CONTACT_TO_EMAIL=arve@astep.no
ORDER_TO_EMAIL=
MAINTENANCE_TO_EMAIL=

# ─────────────────────────────────────────────────────────────
# NETTADRESSE – valgfritt
# ─────────────────────────────────────────────────────────────
# Kanonisk adresse for canonical-/hreflang-lenker og lenker i e-post.
# Tom = utledes av Vercel. Sett den først når domenet er koblet til.
# NEXT_PUBLIC_SITE_URL=https://northwestcoast.no

# ─────────────────────────────────────────────────────────────
# ANALYSE (Plausible – EU-hostet, cookiefri, ingen samtykkebanner) – valgfritt
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://analytics.northwestcoast.no

# ─────────────────────────────────────────────────────────────
# INNHOLD – valgfritt
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAINTENANCE_VIDEO_ID=

NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
