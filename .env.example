# ─────────────────────────────────────────────────────────────
# NETTADRESSE
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://northwestcoast.no

# ─────────────────────────────────────────────────────────────
# SUPABASE (database, auth, fillagring)
# ─────────────────────────────────────────────────────────────
# Prosjekt: northwestcoast, region eu-central-1 (Frankfurt).
#
# VIKTIG: gratisnivået pauser prosjektet etter ~7 dagers inaktivitet.
# I produksjon må prosjektet stå på Pro, ellers stopper Min side av seg selv.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role omgår RLS fullstendig. Kun server-side, aldri i nettleseren,
# aldri i en NEXT_PUBLIC_-variabel.
SUPABASE_SERVICE_ROLE_KEY=

# Brukes kun av `npm run db:types`.
SUPABASE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# E-POST
# ─────────────────────────────────────────────────────────────
# Leverandør bak lib/mail. Bytte til Brevo: legg til lib/mail/brevo.ts,
# ta den inn i switchen i lib/mail/index.ts, og sett MAIL_PROVIDER=brevo.
MAIL_PROVIDER=resend

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@northwestcoast.no

# Mottakere. ORDER_/MAINTENANCE_ faller tilbake på CONTACT_TO_EMAIL.
CONTACT_TO_EMAIL=arve@astep.no
ORDER_TO_EMAIL=
MAINTENANCE_TO_EMAIL=

# ─────────────────────────────────────────────────────────────
# ANALYSE (Plausible – EU-hostet, cookiefri, ingen samtykkebanner)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://analytics.northwestcoast.no

# ─────────────────────────────────────────────────────────────
# INNHOLD
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAINTENANCE_VIDEO_ID=

NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
