# ─────────────────────────────────────────────────────────────
# NETTADRESSE
# ─────────────────────────────────────────────────────────────
# Kanonisk produksjonsdomene. Brukes av sitemap.xml, robots.txt,
# JSON-LD og absolutte OG-bilder. Uten denne faller vi tilbake på
# VERCEL_URL (previews) og deretter https://northwestcoast.no.
NEXT_PUBLIC_SITE_URL=https://northwestcoast.no

# ─────────────────────────────────────────────────────────────
# E-POST (Resend) – kreves for at skjemaene skal levere noe
# ─────────────────────────────────────────────────────────────
# Uten RESEND_API_KEY svarer skjemaene med feil i produksjon,
# framfor å si "takk, vi har mottatt" og kaste henvendelsen.
# Registrer deg på https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@northwestcoast.no

# Hvor henvendelsene havner. ORDER_/MAINTENANCE_ er valgfrie og
# faller tilbake på CONTACT_TO_EMAIL hvis de ikke er satt.
CONTACT_TO_EMAIL=arve@astep.no
ORDER_TO_EMAIL=
MAINTENANCE_TO_EMAIL=

# Resend Audience for nyhetsbrevet. Er den ikke satt, sendes
# påmeldinger kun som varsel-e-post til CONTACT_TO_EMAIL.
RESEND_AUDIENCE_ID=

# ─────────────────────────────────────────────────────────────
# ANALYSE (Plausible – EU-hostet, cookiefri, ingen samtykkebanner)
# ─────────────────────────────────────────────────────────────
# Sett domenet slik det er registrert i Plausible. Er den tom,
# lastes ikke sporingsskriptet i det hele tatt (lokal utvikling
# og previews forurenser dermed ikke statistikken).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Valgfritt: egen instans hvis dere vil hoste analysen selv.
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://analytics.northwestcoast.no

# ─────────────────────────────────────────────────────────────
# INNHOLD
# ─────────────────────────────────────────────────────────────
# YouTube-ID for vedlikeholdsvideoen. Er den tom, vises en
# plassholder med kontaktinfo i stedet for feil video.
NEXT_PUBLIC_MAINTENANCE_VIDEO_ID=

# Sosiale profiler i footeren. Ikoner uten URL skjules.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
