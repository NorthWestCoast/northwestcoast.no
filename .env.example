# Contact form email (Resend)
# Sign up at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@northwestcoast.no
CONTACT_TO_EMAIL=arve@astep.no

# Nyhetsbrev-liste i Resend (valgfri). Uten den sendes påmeldinger på e-post.
RESEND_AUDIENCE_ID=

# YouTube-ID for vedlikeholdsvideoen på /vedlikehold
NEXT_PUBLIC_MAINTENANCE_VIDEO_ID=

# Analytics (valgfritt – begge kan stå tomme)
# Umami er cookiefri og krever ikke samtykkebanner. Anbefalt.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Kun for selvhostet Umami; utelat for Umami Cloud.
NEXT_PUBLIC_UMAMI_SRC=
# Google Tag Manager. Krever samtykkeløsning for EU-besøkende.
NEXT_PUBLIC_GTM_ID=

# Brukes til canonical- og hreflang-lenker
NEXT_PUBLIC_SITE_URL=https://northwestcoast.no
